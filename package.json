{
  "name": "pathfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":               "vite",
    "build":             "vite build",
    "preview":           "vite preview",
    "lint":              "eslint . --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives",
    "typecheck":         "tsc --noEmit",
    "db:reset":          "supabase db reset",
    "db:push":           "supabase db push",
    "db:diff":           "supabase db diff --schema public",
    "functions:serve":   "supabase functions serve --env-file .env.local",
    "functions:deploy":  "supabase functions deploy chat-director --no-verify-jwt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "react":                 "^18.2.0",
    "react-dom":             "^18.2.0"
  },
  "devDependencies": {
    "@types/react":            "^18.2.45",
    "@types/react-dom":        "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser":        "^6.14.0",
    "@vitejs/plugin-react":    "^4.2.1",
    "eslint":                  "^8.55.0",
    "eslint-plugin-react":     "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript":              "^5.3.3",
    "vite":                    "^5.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
